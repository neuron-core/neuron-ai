includes:
    - vendor/tomasvotruba/type-coverage/config/extension.neon

parameters:

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0


    paths:
        - src
        - tests


    # The level 10 is the highest level
    level: 5

    # Analyse against the minimum version in composer.json, whatever PHP runs PHPStan.
    phpVersion: 80100

    treatPhpDocTypesAsCertain: false

    excludePaths:
        - tests/Integration/Frontend/node_modules (?)
        # Dev dependencies install these polyfills, users of the package on PHP 8.1 don't get them.
        - vendor/symfony/polyfill-php8*

    ignoreErrors:
        # Fixtures deliberately declare untyped __invoke signatures to test node validation.
        -
            identifier: typeCoverage.paramTypeCoverage
            path: tests/Workflow/NodeSignatureTest.php

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

